# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Database
DB_NAME=medical_inventory
DB_USER=medinv
DB_PASSWORD=changeme_strong_password_here

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_SECRET=change_this_to_a_random_64_char_string_minimum_32_chars
JWT_REFRESH_SECRET=change_this_to_a_different_random_64_char_string_min_32

# JWT Expiry
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Application
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:4000

# Security
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
